# ──────────────────────────────────────────────
# 数据库
# ──────────────────────────────────────────────
POSTGRES_USER=market
POSTGRES_PASSWORD=change-me
POSTGRES_DB=market
DATABASE_URL=postgresql+asyncpg://market:change-me@localhost:5432/market

# ──────────────────────────────────────────────
# LLM（必填一组，三选一）
# ──────────────────────────────────────────────
# 1. OpenAI 官方
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-xxxx
LLM_API_STYLE=chat_completions
ADMIN_TOKEN=dev-admin-token
TELEGRAM_BOT_TOKEN=

# 2. 国内云端（OpenAI 兼容，举例）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxx
#
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
# LLM_API_KEY=xxxx.xxxx
#
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-xxxx

# 3. 本地 LLM（Ollama / llama.cpp / LM Studio，无需 api key）
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=

# ──────────────────────────────────────────────
# 爬虫调度（cron 5 字段：分 时 日 月 周）
# ──────────────────────────────────────────────
CRAWLER_SCHEDULE=0 2 * * *

# ──────────────────────────────────────────────
# 前端 / 后端（本地开发，端口固定 5173 / 8000）
# 这里仅控制 CORS 白名单派生的端口；想自定义直接填 CORS_ORIGINS
# ──────────────────────────────────────────────
FRONTEND_PORT=5173
# CORS_ORIGINS=http://localhost:5173,http://example.local

# ──────────────────────────────────────────────
# 通知扩展（暂未实现，预留位）
# ──────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFY_FROM=
